# =============================================================================
# SKLP FRONTEND ENVIRONMENT CONFIGURATION (.env)
# =============================================================================

# Backend API Base URL
# For Local Dev: http://localhost:5000/api
# For Vercel Production: https://your-backend-service.onrender.com/api
VITE_API_URL=http://localhost:5000/api

# Application Metadata
VITE_APP_NAME=SKLP
VITE_APP_DESCRIPTION=Premium AI-Powered Fashion Ecommerce Platform

# Razorpay Key ID (Public Key from https://dashboard.razorpay.com/)
# Use test key 'rzp_test_...' for development, or live key 'rzp_live_...' for production
VITE_RAZORPAY_KEY=rzp_test_your_key_id_here
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id_here

# ─────────────────────────────────────────────────────────────────────────────
# GOOGLE OAUTH CONFIGURATION (Optional - for Google One-Tap & Sign-In)
# ─────────────────────────────────────────────────────────────────────────────
# 1. Create a project at https://console.cloud.google.com/
# 2. Add both http://localhost:5173 and https://your-app.vercel.app to Authorized JavaScript Origins
VITE_GOOGLE_CLIENT_ID=
