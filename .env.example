# =============================================================================
# SKLP FASHION ECOMMERCE - MASTER ENVIRONMENT CONFIGURATION
# =============================================================================

# ─────────────────────────────────────────────────────────────────────────────
# 1. BACKEND (Deploy to Render: https://render.com)
# ─────────────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pxxzabh.mongodb.net/sklp_db?retryWrites=true&w=majority
JWT_SECRET=generate_a_64_byte_hex_string_using_crypto_randomBytes_64_for_production
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=generate_another_64_byte_hex_string_for_refresh_token_in_production
JWT_REFRESH_EXPIRE=30d

# Razorpay Configuration (Get keys from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_live_or_test_key_id
RAZORPAY_KEY_SECRET=rzp_live_or_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# Frontend Allowed Origins for CORS
FRONTEND_URL=https://your-frontend.vercel.app
ADMIN_FRONTEND_URL=https://your-frontend.vercel.app

# SMS Gateway (Fast2SMS for India or Twilio for International)
SMS_PROVIDER=auto
FAST2SMS_API_KEY=your_fast2sms_api_key
TWOFACTOR_API_KEY=your_2factor_api_key
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin SDK (Set in Render Dashboard Environment)
FIREBASE_PROJECT_ID=sklp-fashion-store-9fa5d
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# 2. FRONTEND (Deploy to Vercel: https://vercel.com)
# ─────────────────────────────────────────────────────────────────────────────
