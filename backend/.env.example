# =============================================================================
# SKLP BACKEND ENVIRONMENT CONFIGURATION (.env)
# =============================================================================

# Server Port & Environment
PORT=5000
NODE_ENV=development
OTP_MODE=development

# Database Connection (MongoDB Atlas)
# In MongoDB Atlas, ensure Network Access IP is set to 0.0.0.0/0 (allow from anywhere) for Render
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.pxxzabh.mongodb.net/sklp_db?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long_for_security
JWT_EXPIRE=7d
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_minimum_32_characters_long
JWT_REFRESH_EXPIRE=30d

# Razorpay Payment Gateway (Live or Test credentials from https://dashboard.razorpay.com/)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here
RAZORPAY_WEBHOOK_SECRET=your_optional_webhook_secret_here

# Google OAuth (Optional - from https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Frontend URLs for CORS
# In production on Render, set FRONTEND_URL to your Vercel URL (e.g. https://sklp-fashion.vercel.app)
FRONTEND_URL=http://localhost:5173
ADMIN_FRONTEND_URL=http://localhost:5174

# Cloudinary (Optional - for product and profile image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMS Gateway (Supports Fast2SMS, 2Factor, or Twilio - Falls back to Server Console in Development)
SMS_PROVIDER=auto
FAST2SMS_API_KEY=your_fast2sms_api_key_from_fast2sms_com
TWOFACTOR_API_KEY=your_2factor_api_key_from_2factor_in
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SMTP Email (Optional - falls back to console log in development)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Security & Rate Limiting
BCRYPT_ROUNDS=10
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=15
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_AI_FEATURES=true
ENABLE_CHATBOT=true
ENABLE_RECOMMENDATIONS=true
LOG_LEVEL=info
LOG_FILE_PATH=./logs
